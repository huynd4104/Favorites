{
  "manifest_version": 3,
  "key": "",
  "name": "URL Favorites",
  "version": "1.0",
  "description": "Lưu và quản lý các URL yêu thích",
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "tabs",
    "tabCapture",
    "scripting",
    "downloads",
    "alarms",
    "identity"
  ],
  "oauth2": {
    "client_id": "413276963599-sae4pjdc1sv2uh30jeab0ehoq1afvj28.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata",
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "URL Favorites"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fullscreen.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}